// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PARTNER
  ADMIN
}

enum AnnonceType {
  FORMATION
  EMPLOI
  EVENEMENT
}

enum CandidatureStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RdvStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AnnonceStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String           @id @default(uuid())
  nom             String
  prenom          String
  email           String           @unique
  password        String
  telephone       String?
  role            Role             @default(USER)
  avatar          String?
  dateInscription DateTime         @default(now())
  annonces        Annonce[]
  candidatures    Candidature[]
  rendezVous      Rdv[]
  contactsUrgence ContactUrgence[]
  notifications   Notification[]
  groupes         Groupe[]         @relation("GroupeMembres")
  rdvPro          Rdv[]            @relation("ProfessionnelRdv")

  @@index([email])
}

model Annonce {
  id              String           @id @default(uuid())
  titre           String
  type            AnnonceType
  description     String
  contenu         String?
  organisation    String
  organisationId  String?
  lieu            String
  date            DateTime
  dateFin         DateTime?
  deadline        DateTime?
  image           String?
  categories      String
  status          AnnonceStatus    @default(PENDING)
  vues            Int              @default(0)
  details         Json?
  auteur          User             @relation(fields: [auteurId], references: [id])
  auteurId        String
  candidatures    Candidature[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([auteurId])
  @@index([type])
  @@index([status])
}

model Candidature {
  id          String             @id @default(uuid())
  annonce     Annonce            @relation(fields: [annonceId], references: [id])
  annonceId   String
  candidat    User               @relation(fields: [candidatId], references: [id])
  candidatId  String
  message     String?
  cv          String?
  status      CandidatureStatus  @default(PENDING)
  createdAt   DateTime           @default(now())

  @@index([annonceId])
  @@index([candidatId])
}

model Rdv {
  id              String       @id @default(uuid())
  type            String
  professionnel   User?        @relation("ProfessionnelRdv", fields: [professionnelId], references: [id])
  professionnelId String?
  date            DateTime
  heure           String
  motif           String
  status          RdvStatus    @default(PENDING)
  user            User         @relation(fields: [userId], references: [id])
  userId          String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([professionnelId])
}

model Groupe {
  id                String    @id @default(uuid())
  nom               String
  description       String
  horaire           String
  lieu              String
  placesMax         Int
  placesDisponibles Int
  animateur         String
  image             String?
  thematiques       String
  membres           User[]    @relation("GroupeMembres")
  createdAt         DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  link      String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@index([userId])
}

model ContactUrgence {
  id        String   @id @default(uuid())
  nom       String
  prenom    String
  telephone String
  relation  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String

  @@index([userId])
}

model Ressource {
  id          String   @id @default(uuid())
  titre       String
  description String
  categorie   String
  type        String
  url         String
  image       String?
  createdAt   DateTime @default(now())
}
